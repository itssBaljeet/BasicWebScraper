     m.backdrop.observeField("loadStatus", "onBackdropLoadStatusChange")
     m.backdropFadeIn = m.top.findNode("backdropFadeIn")
     m.backdropPrevFadeOut = m.top.findNode("backdropPrevFadeOut")
@@ -803,6 +807,10 @@ sub CleanupObservers()
             end if
         end for
     end if
+    if isValid(m.loadWatchdog)
+        m.loadWatchdog.control = "stop"
+        m.loadWatchdog.unobserveField("fire")
+    end if
 end sub
 
 sub onDiscoveryResponse(event as object)
@@ -1013,19 +1021,63 @@ sub LoadStaticStudios(row as object)
     end for
 end sub
 
+sub StartLoadWatchdog()
+    if isValid(m.loadWatchdog)
+        m.loadWatchdog.control = "stop"
+        m.loadWatchdog.control = "start"
+    end if
+end sub
+
+sub StopLoadWatchdog()
+    if isValid(m.loadWatchdog)
+        m.loadWatchdog.control = "stop"
+    end if
+end sub
+
+sub onLoadWatchdogFired()
+    if not isValid(m.rowsLoading) then return
+    if m.rowsLoading.count() = 0 then return
+
+    stuckRows = []
+    for each key in m.rowsLoading
+        stuckRows.push(key)
+    end for
+
+    for each key in stuckRows
+        m.rowsLoading.delete(key)
+        if isValid(m.isLoadingMore)
+            m.isLoadingMore[key] = false
+        end if
+        if isValid(m.apiTasks) and m.apiTasks.doesExist(key)
+            task = m.apiTasks[key]
+            if isValid(task)
+                task.unobserveField("response")
+            end if
+            m.apiTasks.delete(key)
+        end if
+    end for
+
+    HideLoading()
+    ShowError("Seerr timed out while loading discovery data. Open the Seerr hub and verify the Moonfin plugin session, then check Jellyfin logs for /Moonfin/Jellyseerr/Api errors.")
+end sub
+
 sub ShowLoading()
     m.loadingLabel.visible = true
     m.errorLabel.visible = false
+    StartLoadWatchdog()
 end sub
 
 sub HideLoading()
+    StopLoadWatchdog()
     m.loadingLabel.visible = false
 end sub
 
 sub ShowError(message as string)
+    StopLoadWatchdog()
     m.errorLabel.text = message
     m.errorLabel.visible = true
     m.loadingLabel.visible = false
 end sub
